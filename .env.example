# ==============================================================================
# CHESS ACADEMY — Environment Configuration Template
# Copy this file to .env or configure in deployment settings.
# Never commit actual secret keys to source control.
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"

# AI Provider / Server Configuration (Optional in Task 01; injected at runtime in AI Studio)
GEMINI_API_KEY=""

# Supabase Persistence & Authentication (To be provisioned and configured in subsequent tasks)
# Safe public client variables (exposed to browser via Vite prefix VITE_)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Feature Flags
VITE_ENABLE_ANALYTICS="false"
VITE_APP_ENV="development"
